# Publication App Store de « ELM Boutique » (Flutter, com.elmapp.mobile).
# Lancé par .github/workflows/mobile-ios.yml depuis buyer_app/ios, APRÈS :
#   flutter build ios --release --no-codesign --build-name … --build-number … --dart-define=…
# (qui écrit Generated.xcconfig : version, build et dart-defines repris par l'archive Xcode).

default_platform(:ios)

PROJECT   = "Runner.xcodeproj"
WORKSPACE = "Runner.xcworkspace"
BUNDLE_ID = "com.elmapp.mobile"

platform :ios do
  desc "Archive signée + envoi App Store Connect (+ soumission à la review si SUBMIT_FOR_REVIEW=true)"
  lane :release do
    version = ENV.fetch("APP_VERSION")

    # Keychain temporaire (fastlane_tmp_keychain) — no-op hors CI
    setup_ci

    api_key = app_store_connect_api_key(
      key_id:      ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id:   ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY"),
    )

    import_certificate(
      certificate_path:     ENV.fetch("APPLE_CERTIFICATE_PATH"),
      certificate_password: ENV.fetch("APPLE_CERTIFICATE_PASSWORD"),
      keychain_name:        ENV.fetch("MATCH_KEYCHAIN_NAME"),
      keychain_password:    ENV["MATCH_KEYCHAIN_PASSWORD"],
    )

    profile_path = ENV.fetch("APPLE_PROVISIONING_PROFILE_PATH")
    install_provisioning_profile(path: profile_path)
    profile = FastlaneCore::ProvisioningProfile.parse(profile_path)

    # Signature manuelle sur la seule cible Runner : passée en xcargs, elle toucherait
    # aussi les Pods / paquets SPM des plugins, qui refusent les provisioning profiles.
    update_code_signing_settings(
      path:                  PROJECT,
      use_automatic_signing: false,
      targets:               ["Runner"],
      build_configurations:  ["Release"],
      team_id:               ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier:     BUNDLE_ID,
      code_sign_identity:    "Apple Distribution",
      profile_name:          profile["Name"],
      profile_uuid:          profile["UUID"],
    )

    build_app(
      workspace:        WORKSPACE,
      scheme:           "Runner",
      configuration:    "Release",
      output_directory: "build",
      output_name:      "Runner.ipa",
      export_method:    "app-store",
      export_options:   { provisioningProfiles: { BUNDLE_ID => profile["Name"] } },
    )

    ipa = lane_context[SharedValues::IPA_OUTPUT_PATH]

    unless ENV["SUBMIT_FOR_REVIEW"] == "true"
      # TestFlight seulement : binaire uniquement, aucune métadonnée — App Store Connect
      # refuse les « Nouveautés » sur la toute première version d'une app.
      upload_to_testflight(api_key: api_key, ipa: ipa, skip_waiting_for_build_processing: true)
      next
    end

    notes = ENV["RELEASE_NOTES"].to_s.strip
    upload_to_app_store(
      api_key:                    api_key,
      ipa:                        ipa,
      app_version:                version,
      skip_screenshots:           true,
      skip_metadata:              notes.empty?,
      release_notes:              notes.empty? ? nil : { "default" => notes },
      submit_for_review:          true,
      automatic_release:          true,
      force:                      true, # pas d'aperçu HTML à valider en CI
      run_precheck_before_submit: false,
      submission_information:     { add_id_info_uses_idfa: false },
    )
  end
end
